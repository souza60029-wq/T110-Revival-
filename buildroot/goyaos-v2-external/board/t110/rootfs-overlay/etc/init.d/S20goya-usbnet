#!/bin/sh

configure_usbnet() {
    count=0
    while [ "$count" -lt 20 ]; do
        for node in /sys/class/net/usb*; do
            [ -e "$node" ] || continue
            iface=${node##*/}
            /sbin/ifconfig "$iface" 192.168.7.2 netmask 255.255.255.0 up >/dev/null 2>&1
            return 0
        done
        sleep 1
        count=$((count + 1))
    done
    return 0
}

case "$1" in
    start)
        configure_usbnet &
        ;;
    stop|restart|reload)
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload}" >&2
        exit 1
        ;;
esac

exit 0
